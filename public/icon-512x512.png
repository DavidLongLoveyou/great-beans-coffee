<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <radialGradient id="coffeeGradient" cx="50%" cy="30%" r="70%">
      <stop offset="0%" style="stop-color:#8B4513;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#5D2F0A;stop-opacity:1" />
    </radialGradient>
    <linearGradient id="bgGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#F5F5DC;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#DEB887;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="512" height="512" rx="50" ry="50" fill="url(#bgGradient)" />
  
  <!-- Coffee bean shape -->
  <ellipse cx="256" cy="256" rx="170" ry="200" fill="url(#coffeeGradient)" />
  
  <!-- Coffee bean crack -->
  <path d="M256 56 Q314 256 256 456 Q198 256 256 56" fill="#3D1A00" opacity="0.6" />
  
  <!-- Highlight -->
  <ellipse cx="198" cy="170" rx="42" ry="58" fill="#A0522D" opacity="0.7" />
  
  <!-- Company name -->
  <text x="256" y="480" font-family="Arial, sans-serif" font-size="36" font-weight="bold" text-anchor="middle" fill="#5D2F0A">GREAT BEANS</text>
</svg>