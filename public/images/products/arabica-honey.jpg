<svg width="400" height="300" viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="honeyGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#FFD700;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#FFA500;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#FF8C00;stop-opacity:1" />
    </linearGradient>
    <radialGradient id="honeyBeanGradient" cx="50%" cy="30%" r="70%">
      <stop offset="0%" style="stop-color:#DEB887;stop-opacity:1" />
      <stop offset="70%" style="stop-color:#D2691E;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#A0522D;stop-opacity:1" />
    </radialGradient>
    <radialGradient id="honeyDropGradient" cx="30%" cy="30%" r="70%">
      <stop offset="0%" style="stop-color:#FFD700;stop-opacity:0.8" />
      <stop offset="100%" style="stop-color:#FFA500;stop-opacity:0.3" />
    </radialGradient>
  </defs>
  
  <!-- Background -->
  <rect width="400" height="300" fill="url(#honeyGradient)"/>
  
  <!-- Honey drops effect -->
  <circle cx="100" cy="50" r="8" fill="url(#honeyDropGradient)"/>
  <circle cx="300" cy="80" r="6" fill="url(#honeyDropGradient)"/>
  <circle cx="150" cy="200" r="10" fill="url(#honeyDropGradient)"/>
  <circle cx="350" cy="220" r="7" fill="url(#honeyDropGradient)"/>
  
  <!-- Coffee beans with honey processing look -->
  <ellipse cx="80" cy="80" rx="12" ry="18" fill="url(#honeyBeanGradient)" transform="rotate(25 80 80)"/>
  <ellipse cx="150" cy="60" rx="12" ry="18" fill="url(#honeyBeanGradient)" transform="rotate(-15 150 60)"/>
  <ellipse cx="220" cy="90" rx="12" ry="18" fill="url(#honeyBeanGradient)" transform="rotate(45 220 90)"/>
  <ellipse cx="320" cy="70" rx="12" ry="18" fill="url(#honeyBeanGradient)" transform="rotate(-30 320 70)"/>
  
  <ellipse cx="60" cy="150" rx="12" ry="18" fill="url(#honeyBeanGradient)" transform="rotate(60 60 150)"/>
  <ellipse cx="180" cy="140" rx="12" ry="18" fill="url(#honeyBeanGradient)" transform="rotate(-45 180 140)"/>
  <ellipse cx="280" cy="160" rx="12" ry="18" fill="url(#honeyBeanGradient)" transform="rotate(15 280 160)"/>
  <ellipse cx="350" cy="180" rx="12" ry="18" fill="url(#honeyBeanGradient)" transform="rotate(-60 350 180)"/>
  
  <ellipse cx="100" cy="220" rx="12" ry="18" fill="url(#honeyBeanGradient)" transform="rotate(30 100 220)"/>
  <ellipse cx="200" cy="240" rx="12" ry="18" fill="url(#honeyBeanGradient)" transform="rotate(-20 200 240)"/>
  <ellipse cx="300" cy="230" rx="12" ry="18" fill="url(#honeyBeanGradient)" transform="rotate(50 300 230)"/>
  
  <!-- Bean cracks -->
  <line x1="75" y1="80" x2="85" y2="80" stroke="#8B4513" stroke-width="1"/>
  <line x1="145" y1="60" x2="155" y2="60" stroke="#8B4513" stroke-width="1"/>
  <line x1="215" y1="90" x2="225" y2="90" stroke="#8B4513" stroke-width="1"/>
  <line x1="315" y1="70" x2="325" y2="70" stroke="#8B4513" stroke-width="1"/>
  
  <!-- Honey processing indicator -->
  <path d="M 30 30 Q 40 20 50 30 Q 40 40 30 30" fill="#FFD700" opacity="0.7"/>
  <path d="M 35 25 Q 42 18 48 25" fill="#FFA500" opacity="0.5"/>
  
  <!-- Product label -->
  <rect x="50" y="250" width="300" height="40" fill="rgba(0,0,0,0.7)" rx="5"/>
  <text x="200" y="275" text-anchor="middle" fill="white" font-family="Arial, sans-serif" font-size="18" font-weight="bold">
    Arabica Honey Process
  </text>
  
  <!-- Processing badge -->
  <rect x="320" y="35" width="60" height="30" fill="rgba(255,255,255,0.9)" rx="15"/>
  <text x="350" y="45" text-anchor="middle" fill="#D2691E" font-family="Arial, sans-serif" font-size="8" font-weight="bold">
    HONEY
  </text>
  <text x="350" y="55" text-anchor="middle" fill="#D2691E" font-family="Arial, sans-serif" font-size="8">
    PROCESS
  </text>
</svg>