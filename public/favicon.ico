<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="32" height="32">
  <defs>
    <radialGradient id="coffeeGradient" cx="50%" cy="30%" r="70%">
      <stop offset="0%" style="stop-color:#8B4513;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#5D2F0A;stop-opacity:1" />
    </radialGradient>
  </defs>
  
  <!-- Coffee bean shape -->
  <ellipse cx="16" cy="16" rx="12" ry="14" fill="url(#coffeeGradient)" />
  
  <!-- Coffee bean crack -->
  <path d="M16 4 Q20 16 16 28 Q12 16 16 4" fill="#3D1A00" opacity="0.6" />
  
  <!-- Highlight -->
  <ellipse cx="12" cy="10" rx="3" ry="4" fill="#A0522D" opacity="0.7" />
</svg>