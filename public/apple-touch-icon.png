<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 180 180" width="180" height="180">
  <defs>
    <radialGradient id="coffeeGradient" cx="50%" cy="30%" r="70%">
      <stop offset="0%" style="stop-color:#8B4513;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#5D2F0A;stop-opacity:1" />
    </radialGradient>
    <linearGradient id="bgGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#F5F5DC;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#DEB887;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background with rounded corners for iOS -->
  <rect width="180" height="180" rx="40" ry="40" fill="url(#bgGradient)" />
  
  <!-- Coffee bean shape -->
  <ellipse cx="90" cy="90" rx="60" ry="70" fill="url(#coffeeGradient)" />
  
  <!-- Coffee bean crack -->
  <path d="M90 20 Q110 90 90 160 Q70 90 90 20" fill="#3D1A00" opacity="0.6" />
  
  <!-- Highlight -->
  <ellipse cx="70" cy="60" rx="15" ry="20" fill="#A0522D" opacity="0.7" />
  
  <!-- Company name -->
  <text x="90" y="170" font-family="Arial, sans-serif" font-size="12" font-weight="bold" text-anchor="middle" fill="#5D2F0A">GREAT BEANS</text>
</svg>